---
import { Icon } from "astro-icon/components";
import type { BookmarkCategory as BookmarkCategoryType, BookmarkGroup } from "@/types/config";
import BookmarkCard from "./BookmarkCard.astro";

interface Props {
  category: BookmarkCategoryType;
  level?: number;
}

const { category, level = 1 } = Astro.props;
const subcategories = category.subcategories || [];
const groups = category.groups || [];
const sites = category.sites || [];
const hasSubcategories = subcategories.length > 0;
const hasGroups = groups.length > 0;
const hasSites = sites.length > 0;
---

<section class:list={["category", `category-level-${level}`]} id={category.name}>
  <div class="category-header">
    {level === 1 && (
      <h2>
        {category.icon && <Icon name={category.icon} />}
        {category.name}
      </h2>
    )}
    {level === 2 && (
      <h3>
        {category.icon && <Icon name={category.icon} />}
        {category.name}
      </h3>
    )}
    {level === 3 && (
      <h4>
        {category.icon && <Icon name={category.icon} />}
        {category.name}
      </h4>
    )}
    {level > 3 && (
      <h5>
        {category.icon && <Icon name={category.icon} />}
        {category.name}
      </h5>
    )}
  </div>

  <div class="category-content">
    {/* 子分类 */}
    {hasSubcategories && (
      <div class="subcategories-container">
        {subcategories.map((subCategory) => (
          <section class:list={["category", `category-level-${level + 1}`]} id={subCategory.name}>
            <div class="category-header">
              {level + 1 === 2 && (
                <h3>
                  {subCategory.icon && <Icon name={subCategory.icon} />}
                  {subCategory.name}
                </h3>
              )}
              {level + 1 === 3 && (
                <h4>
                  {subCategory.icon && <Icon name={subCategory.icon} />}
                  {subCategory.name}
                </h4>
              )}
              {level + 1 > 3 && (
                <h5>
                  {subCategory.icon && <Icon name={subCategory.icon} />}
                  {subCategory.name}
                </h5>
              )}
            </div>
            <div class="category-content">
              {subCategory.groups && subCategory.groups.length > 0 && (
                <div class="groups-container">
                  {subCategory.groups.map((group: BookmarkGroup) => (
                    <div class="group group-level-3">
                      <div class="group-header">
                        <h4>
                          {group.icon && <Icon name={group.icon} />}
                          {group.name}
                        </h4>
                      </div>
                      <div class="group-content">
                        <div class="sites-grid">
                          {group.sites.map((site) => (
                            <BookmarkCard site={site} />
                          ))}
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              )}
              {subCategory.sites && subCategory.sites.length > 0 && (
                <div class="sites-grid">
                  {subCategory.sites.map((site) => (
                    <BookmarkCard site={site} />
                  ))}
                </div>
              )}
            </div>
          </section>
        ))}
      </div>
    )}

    {/* 分组 */}
    {hasGroups && (
      <div class="groups-container">
        {groups.map((group: BookmarkGroup) => (
          <div class="group group-level-3">
            <div class="group-header">
              <h4>
                {group.icon && <Icon name={group.icon} />}
                {group.name}
              </h4>
            </div>
            <div class="group-content">
              <div class="sites-grid">
                {group.sites.map((site) => (
                  <BookmarkCard site={site} />
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    )}

    {/* 直接的书签 */}
    {hasSites && (
      <div class="sites-grid">
        {sites.map((site) => (
          <BookmarkCard site={site} />
        ))}
      </div>
    )}
  </div>
</section>
