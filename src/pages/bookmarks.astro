---
import { Icon } from "astro-icon/components";
import { bookmarksPageConfig, commentConfig, siteConfig } from "@/config";
import BookmarkCategory from "@/components/pages/BookmarkCategory.astro";
import Comment from "@components/comment/index.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 检查页面是否启用
if (!siteConfig.pages.bookmarks) {
  return Astro.redirect("/404/");
}

// 检查评论系统是否启用
const isCommentEnabled =
  commentConfig?.type &&
  commentConfig.type !== "none" &&
  bookmarksPageConfig.showComment !== false;

// 页面标题和描述
const title = bookmarksPageConfig.title || i18n(I18nKey.bookmarks);
const description =
  bookmarksPageConfig.description || i18n(I18nKey.bookmarksDescription);

// 书签分类数据
const categories = bookmarksPageConfig.categories || [];
---

<MainGridLayout title={title} description={description}>
  <div class="bookmarks-container">
    {/* 页面标题和描述 */}
    <div class="bookmarks-header">
      <div class="bookmarks-title-row">
        <div class="bookmarks-icon">
          <Icon name="material-symbols:bookmarks" />
        </div>
        <h1>{title}</h1>
      </div>
      {description && <p class="bookmarks-description">{description}</p>}
    </div>

    {/* 书签分类列表 */}
    <div class="bookmarks-content">
      {categories.map((category) => (
        <BookmarkCategory category={category} />
      ))}
    </div>

    {/* 空状态 */}
    {categories.length === 0 && (
      <div class="bookmarks-empty">
        <Icon name="material-symbols:bookmarks" />
        <p>暂无书签数据</p>
      </div>
    )}
  </div>

  {/* 评论区 */}
  {isCommentEnabled && (
    <div class="mt-4">
      <Comment post={undefined} customPath="/bookmarks/" />
    </div>
  )}
</MainGridLayout>

<style>
  .bookmarks-container {
    width: 100%;
  }

  .bookmarks-header {
    margin-bottom: 1.5rem;
    padding: 0 0.5rem;
  }

  .bookmarks-title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .bookmarks-icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-medium, 0.75rem);
    background: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
  }

  .bookmarks-icon :global(svg) {
    font-size: 1.5rem;
  }

  .bookmarks-header h1 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text-100, var(--text-primary));
    margin: 0;
    letter-spacing: 0.5px;
  }

  .bookmarks-description {
    color: var(--text-50, var(--text-secondary));
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
  }

  .bookmarks-content {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .bookmarks-empty {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--text-30, var(--text-tertiary));
  }

  .bookmarks-empty :global(svg) {
    font-size: 4rem;
    margin-bottom: 1rem;
    opacity: 0.5;
  }

  .bookmarks-empty p {
    font-size: 1rem;
    margin: 0;
  }

  /* Category 样式 - 匹配 menav */
  :global(.category) {
    background: linear-gradient(145deg, var(--card-bg), color-mix(in srgb, var(--card-bg) 95%, white));
    border-radius: var(--radius-large, 1rem);
    padding: 1rem;
    margin: 0 auto;
    width: 100%;
    position: relative;
    z-index: 1;
    opacity: 1;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    border: 1px solid var(--line-divider);
    transition: background 0.35s ease, box-shadow 0.35s ease;
  }

  :global(.category-header) {
    border-radius: var(--radius-medium, 0.75rem);
    padding: 0.4rem;
    margin: -0.4rem -0.4rem 0.8rem;
    transition: all 0.35s ease;
  }

  :global(.category-header h2),
  :global(.category-header h3),
  :global(.category-header h4),
  :global(.category-header h5) {
    font-size: 1.2rem;
    margin-bottom: 0;
    color: var(--text-100, var(--text-primary));
    display: flex;
    align-items: center;
    gap: 0.8rem;
    letter-spacing: 0.3px;
    transition: color 0.3s ease;
  }

  :global(.category-header h2 :global(svg)),
  :global(.category-header h3 :global(svg)),
  :global(.category-header h4 :global(svg)),
  :global(.category-header h5 :global(svg)) {
    color: var(--primary);
    font-size: 1.3rem;
    transition: all 0.3s ease;
  }

  /* 子分类样式 - 匹配 menav */
  :global(.category-level-2),
  :global(.category-level-3),
  :global(.category-level-4) {
    background: none;
    border: none;
    box-shadow: none;
    padding: 0;
    width: 100%;
    margin: 0;
  }

  :global(.category-level-2) {
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 1rem;
    border-left: none;
    position: relative;
  }

  :global(.category-level-2::before) {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: var(--line-divider);
    opacity: 0.6;
  }

  :global(.category-level-2 .category-header) {
    margin: 0 -0.5rem 1rem;
    padding: 0.5rem;
    background: none;
    border-radius: var(--radius-medium, 0.75rem);
  }

  :global(.category-level-2 .category-header h3) {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-100, var(--text-primary));
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  :global(.category-level-2 .category-header h3 :global(svg)) {
    color: var(--primary);
    font-size: 1.2rem;
    opacity: 0.9;
  }

  /* Group 样式 - 匹配 menav */
  :global(.group-level-3) {
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 1rem;
    position: relative;
  }

  :global(.group-level-3::before) {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: var(--line-divider);
    opacity: 0.6;
  }

  :global(.group-header) {
    margin: 0 0 0.8rem;
    padding: 0.3rem 0;
    background: none;
  }

  :global(.group-header h4) {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-80, var(--text-primary));
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
  }

  :global(.group-header h4 :global(svg)) {
    color: var(--text-50, var(--text-secondary));
    font-size: 1rem;
  }

  /* 网格布局 - 匹配 menav */
  :global(.sites-grid) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.75rem;
    position: relative;
    z-index: 1;
    width: 100%;
  }

  :global(.subcategories-container),
  :global(.groups-container) {
    width: 100%;
  }

  :global(.subcategories-container > .category-level-2 + .category-level-2) {
    margin-top: 1rem;
  }

  :global(.groups-container > .group-level-3 + .group-level-3) {
    margin-top: 0.8rem;
  }

  /* Site Card 样式 - 匹配 menav */
  :global(.site-card) {
    display: flex;
    align-items: center;
    padding: 0.75rem 0.9rem;
    gap: 0.6rem;
    background: linear-gradient(145deg, var(--card-bg), color-mix(in srgb, var(--card-bg) 95%, white));
    border-radius: var(--radius-medium, 0.75rem);
    text-decoration: none;
    color: inherit;
    transition: all 0.35s cubic-bezier(0.25, 1, 0.5, 1);
    position: relative;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    border: 1px solid var(--line-divider);
    z-index: 2;
    overflow: hidden;
    max-width: 100%;
  }

  :global(.site-card:hover) {
    transform: translateY(-3px);
    background: color-mix(in srgb, var(--card-bg) 90%, white);
    border-color: var(--primary);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
  }

  :global(.site-card-icon) {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-medium, 0.75rem);
    background: color-mix(in srgb, var(--primary) 10%, transparent);
    border: 1px solid var(--line-divider);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease, background-color 0.3s ease;
  }

  :global(.site-icon) {
    font-size: 1.4rem;
    color: var(--primary);
    transition: color 0.3s ease;
  }

  :global(.site-card:hover .site-card-icon) {
    transform: scale(1.06);
    background: color-mix(in srgb, var(--primary) 15%, transparent);
  }

  :global(.site-card-content) {
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }

  :global(.site-card-content h3) {
    font-size: 1rem;
    margin-bottom: 0.25rem;
    color: var(--text-100, var(--text-primary));
    font-weight: 500;
    letter-spacing: 0.3px;
    transition: color 0.3s ease;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  :global(.site-card-content p) {
    font-size: 0.9rem;
    color: var(--text-50, var(--text-secondary));
    margin: 0;
    line-height: 1.4;
    transition: color 0.3s ease;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    width: 100%;
  }

  :global(.site-card:hover .site-card-content h3) {
    color: var(--primary);
  }

  /* 响应式 - 匹配 menav */
  @media (max-width: 768px) {
    :global(.category) {
      padding: 1rem;
    }

    :global(.category-level-2),
    :global(.group-level-3) {
      padding-left: 0.75rem;
    }

    :global(.sites-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.5rem;
    }

    :global(.site-card) {
      padding: 0.6rem 0.65rem;
      gap: 0.5rem;
    }

    :global(.site-card-icon) {
      width: 2.2rem;
      height: 2.2rem;
    }

    :global(.site-icon) {
      font-size: 1.2rem;
    }

    :global(.site-card-content h3) {
      font-size: 0.95rem;
    }

    :global(.site-card-content p) {
      font-size: 0.85rem;
    }
  }

  @media (max-width: 480px) {
    :global(.sites-grid) {
      gap: 0.4rem;
    }

    :global(.site-card) {
      padding: 0.5rem;
      gap: 0.45rem;
    }

    :global(.site-card-icon) {
      width: 1.9rem;
      height: 1.9rem;
    }

    :global(.site-icon) {
      font-size: 1.1rem;
    }
  }
</style>
